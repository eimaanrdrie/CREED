APP_NAME=CREED API
APP_ENV=development
APP_VERSION=0.94.6
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://creed:creed@localhost:5432/creed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_RUNTIME_MODEL=qwen3.5:4b
OLLAMA_INVESTIGATION_MODEL=qwen3.5:4b
OLLAMA_LEARNING_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_INVESTIGATION_TIMEOUT_SECONDS=45
OLLAMA_LEARNING_TIMEOUT_SECONDS=180
LEARNING_CONTEXT_WINDOW=8192
LEARNING_NUM_PREDICT=900
LEARNING_EXCERPT_CHARS=1400
LEARNING_GENERATION_ATTEMPTS=3
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARM_ON_STARTUP=true
QWEN_LOG_PATH=.data/qwen-runs.jsonl
DOCUMENT_STORAGE_PATH=.data/documents
MAX_DOCUMENT_BYTES=20971520

# M05 local retrieval
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_SECONDS=45
EMBEDDING_ALLOW_HASH_FALLBACK=true
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_SEMANTIC_WEIGHT=0.55
RETRIEVAL_KEYWORD_WEIGHT=0.35
RETRIEVAL_METADATA_WEIGHT=0.10

# M08 LangGraph orchestration
LANGGRAPH_CHECKPOINT_PATH=.data/langgraph-checkpoints.sqlite
ANALYSIS_EVENT_POLL_SECONDS=0.35
ANALYSIS_EVENT_MAX_SECONDS=180

# M09-M20 final CREED intelligence
DISCOVERY_TOP_K=8
DISCOVERY_ISSUE_LINK_BOOST=0.08
DISCOVERY_QUERY_COVERAGE_BONUS=0.03
DISCOVERY_MIN_BASE_SCORE=0.20
INVESTIGATION_TOP_K=3
INVESTIGATION_MAX_DOCS=2
INVESTIGATION_EXCERPT_CHARS=450
INVESTIGATION_AUTHORITATIVE_CONFIG_CHARS=2400
INVESTIGATION_ISSUE_CHARS=220
INVESTIGATION_NUM_PREDICT=170
INVESTIGATION_CONTEXT_WINDOW=2048
INVESTIGATION_RETRY_MIN_SECONDS=8
INVESTIGATION_USE_HEURISTIC_FAST_PATH=false
HUMAN_REVIEW_MAX_CYCLES=3
DEMO_MODE_ENABLED=false
